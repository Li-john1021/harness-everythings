{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-everythings/v1/domain-pack-manifest.schema.json",
  "title": "DomainPackManifest",
  "type": "object",
  "required": ["schema_version", "entity_type", "pack_id", "pack_version", "kernel_min_version", "license", "supported_workspace_types", "supported_artifact_types", "runtime_capabilities", "stages", "role_templates", "validators", "verification_classes", "release_approval", "generation_basis", "capabilities", "external_tools", "models", "network", "credentials", "publishing", "publication", "compatibility", "deprecation", "context_routes", "fixtures", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity_type": { "const": "domain-pack-manifest" },
    "pack_id": { "type": "string", "minLength": 1 },
    "pack_version": { "type": "string", "minLength": 1 },
    "kernel_min_version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "supported_workspace_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "supported_artifact_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "runtime_capabilities": {
      "type": "object",
      "required": ["required", "optional"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stages": { "type": "array", "items": { "type": "object", "required": ["stage_id", "canonical_state", "entry_conditions", "exit_conditions"], "additionalProperties": false, "properties": { "stage_id": { "type": "string" }, "canonical_state": { "type": "string" }, "entry_conditions": { "type": "array", "items": { "type": "string" } }, "exit_conditions": { "type": "array", "items": { "type": "string" } } } } },
    "role_templates": { "type": "array", "items": { "type": "object", "required": ["role_id", "role_contract_version", "mission", "permissions", "owns", "forbids", "capabilities", "input_contract_refs", "output_contract_refs", "artifact_obligations", "evidence_obligations", "verification", "stop_conditions", "dependencies", "concurrency_boundaries", "merge_group"], "additionalProperties": false, "properties": { "role_id": { "type": "string" }, "role_contract_version": { "type": "string" }, "mission": { "type": "string" }, "permissions": { "type": "array", "items": { "type": "string" } }, "owns": { "type": "array", "items": { "type": "string" } }, "forbids": { "type": "array", "items": { "type": "string" } }, "capabilities": { "type": "array", "items": { "type": "string" } }, "input_contract_refs": { "type": "array", "items": { "type": "string" } }, "output_contract_refs": { "type": "array", "items": { "type": "string" } }, "artifact_obligations": { "type": "array", "items": { "type": "object", "required": ["kind", "contract_ref", "required"], "additionalProperties": false, "properties": { "kind": { "type": "string" }, "contract_ref": { "type": "string" }, "required": { "type": "boolean" } } } }, "evidence_obligations": { "type": "array", "items": { "type": "object", "required": ["kind", "contract_ref", "required"], "additionalProperties": false, "properties": { "kind": { "type": "string" }, "contract_ref": { "type": "string" }, "required": { "type": "boolean" } } } }, "verification": { "type": "object", "required": ["methods", "independent", "evidence_required"], "additionalProperties": false, "properties": { "methods": { "type": "array", "items": { "type": "string" } }, "independent": { "type": "boolean" }, "evidence_required": { "type": "boolean" } } }, "stop_conditions": { "type": "array", "items": { "type": "string" } }, "dependencies": { "type": "array", "items": { "type": "string" } }, "concurrency_boundaries": { "type": "object", "required": ["shared", "exclusive"], "additionalProperties": false, "properties": { "shared": { "type": "array", "items": { "type": "string" } }, "exclusive": { "type": "array", "items": { "type": "string" } } } }, "merge_group": { "type": "string" } } } },
    "validators": { "type": "array", "items": { "type": "object", "required": ["validator_id", "kind", "deterministic", "human_gate"], "additionalProperties": false, "properties": { "validator_id": { "type": "string" }, "kind": { "type": "string" }, "deterministic": { "type": "boolean" }, "human_gate": { "type": "boolean" } } } },
    "verification_classes": { "type": "array", "items": { "enum": ["build", "test", "static", "manual", "hardware"] } },
    "release_approval": { "type": "object", "required": ["delivery_scope", "external_release_scope", "separate_approval_required"], "additionalProperties": false, "properties": { "delivery_scope": { "type": "string" }, "external_release_scope": { "type": "string" }, "separate_approval_required": { "type": "boolean" } } },
    "generation_basis": { "type": "array", "items": { "enum": ["ownership", "risk", "verification", "concurrency"] } },
    "capabilities": { "type": "object", "required": ["discovery", "execution", "verification"], "additionalProperties": false, "properties": { "discovery": { "type": "array", "items": { "type": "string" } }, "execution": { "type": "array", "items": { "type": "string" } }, "verification": { "type": "array", "items": { "type": "string" } } } },
    "external_tools": { "type": "array", "items": { "type": "string" } },
    "models": { "type": "array", "items": { "type": "string" } },
    "network": { "type": "object", "required": ["allowed", "destinations"], "additionalProperties": false, "properties": { "allowed": { "type": "boolean" }, "destinations": { "type": "array", "items": { "type": "string" } } } },
    "credentials": { "type": "object", "required": ["required", "kinds"], "additionalProperties": false, "properties": { "required": { "type": "boolean" }, "kinds": { "type": "array", "items": { "type": "string" } } } },
    "publishing": { "type": "object", "required": ["allowed", "approval_scope"], "additionalProperties": false, "properties": { "allowed": { "type": "boolean" }, "approval_scope": { "type": "string" } } },
    "publication": { "type": "object", "required": ["allowed", "approval_scope"], "additionalProperties": false, "properties": { "allowed": { "type": "boolean" }, "approval_scope": { "type": "string" } } },
    "compatibility": {
      "type": "object",
      "required": ["supported_kernel_versions", "supported_pack_versions", "migration_from_pack_versions", "migration_strategy"],
      "additionalProperties": false,
      "properties": {
        "supported_kernel_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "supported_pack_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "migration_from_pack_versions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "migration_strategy": { "type": "string", "minLength": 1 }
      }
    },
    "deprecation": {
      "type": "object",
      "required": ["status", "deprecated_since", "removal_version", "replacement_pack_id", "policy"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "deprecated"] },
        "deprecated_since": { "type": "string" },
        "removal_version": { "type": "string" },
        "replacement_pack_id": { "type": "string" },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "context_routes": { "type": "array", "items": { "type": "object", "required": ["route_id", "purpose", "owner_role_id", "allowed_sensitivity"], "additionalProperties": false, "properties": { "route_id": { "type": "string" }, "purpose": { "type": "string" }, "owner_role_id": { "type": "string" }, "allowed_sensitivity": { "type": "array", "items": { "enum": ["public", "internal", "sensitive"] } } } } },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["fixture_id", "path", "scenario_type", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "scenario_type": { "enum": ["normal-closure", "controlled-failure-recovery"] },
          "fingerprint": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fingerprint": { "type": "string" }
  }
}

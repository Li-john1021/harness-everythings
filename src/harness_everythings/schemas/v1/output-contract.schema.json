{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-everythings/v1/output-contract.schema.json",
  "title": "OutputContract",
  "type": "object",
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "created_at",
    "updated_at",
    "source_ref",
    "derived_from_plan",
    "observable_requirements",
    "acceptance_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity_id": { "type": "string" },
    "entity_type": { "const": "output-contract" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "source_ref": { "type": "string" },
    "derived_from_plan": { "type": "string" },
    "observable_requirements": { "type": "array", "items": { "type": "object" } },
    "acceptance_conditions": { "type": "array", "items": { "type": "object" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-everythings/v1/workspace.schema.json",
  "title": "Workspace",
  "type": "object",
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "created_at",
    "updated_at",
    "source_ref",
    "workspace_name",
    "workspace_kind",
    "lifecycle_state",
    "enabled_domain_packs",
    "config_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity_id": { "type": "string" },
    "entity_type": { "const": "workspace" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "source_ref": { "type": "string" },
    "workspace_name": { "type": "string" },
    "workspace_kind": {
      "enum": ["new", "existing", "mixed"]
    },
    "lifecycle_state": {
      "enum": ["proposed", "initialized", "active", "retired"]
    },
    "enabled_domain_packs": { "type": "array", "items": { "type": "string" } },
    "config_version": { "type": "string" }
  }
}

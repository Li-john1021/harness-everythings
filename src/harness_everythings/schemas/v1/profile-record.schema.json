{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-everythings/v1/profile-record.schema.json",
  "title": "ProfileRecord",
  "type": "object",
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "created_at",
    "updated_at",
    "source_ref",
    "status",
    "sensitivity",
    "fact_key",
    "fact_value"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity_id": { "type": "string" },
    "entity_type": { "const": "profile-record" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "source_ref": { "type": "string" },
    "status": {
      "enum": ["observed", "inferred", "user_confirmed", "unresolved", "disproved"]
    },
    "sensitivity": {
      "enum": ["public", "internal", "personal", "secret", "employer", "licensed"]
    },
    "fact_key": { "type": "string" },
    "fact_value": {},
    "confidence": { "type": "number" },
    "freshness": { "type": "string" }
  }
}
